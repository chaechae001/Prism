{
  "name": "prism-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:http": "node scripts/dev-http.mjs",
    "dev:lan": "vite --config vite.lan.config.ts --host 127.0.0.1 --port 5185",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "types:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "mock:init": "msw init public --save"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "msw": "^2.11.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
