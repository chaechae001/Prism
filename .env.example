# Server-only PostgreSQL connection (Supabase Session pooler).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
PRISM_DATA_SOURCE=fixture
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183
# AI provider settings: backend/.env.chat.example
# Supabase Auth public configuration (never use a service_role/secret key here).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PRISM_ACCOUNTS_ENABLED=0
# Set to 1 only behind HTTPS in deployment.
PRISM_COOKIE_SECURE=0
# Loopback-only editorial routes; the connected-news launcher enables them locally.
PRISM_EDITORIAL_ENABLED=0
PRISM_BODY_PREVIEW_ENABLED=0
PRISM_LANGCHAIN_ENABLED=0
PRISM_RAG_ENABLED=0
PRISM_LLM_METRICS_ENABLED=0
PRISM_OPIK_ENABLED=0
PRISM_E5_MODEL_DIR=.models/multilingual-e5-small
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OPIK_URL_OVERRIDE=http://127.0.0.1:5174/api
OPIK_PROJECT_NAME=prism
# Optional estimates; leave unset when the provider's billed unit is unknown.
PRISM_INPUT_USD_PER_MILLION=
PRISM_OUTPUT_USD_PER_MILLION=

# Retrieval backend: e5 (local ONNX files) or ollama (installed BGE-M3 only)
PRISM_EMBEDDING_PROVIDER=e5
OLLAMA_EMBED_MODEL=bge-m3:latest
