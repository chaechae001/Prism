# Server only. Copy to backend/.env.chat.local; never put credentials in VITE_*.
PRISM_CHAT_PROVIDER=elice
ELICE_API_KEY=
# Elice base URL + /v1/chat/completions (avoid appending the path twice).
# Example: https://mlapi.run/<endpoint-uuid>/v1/chat/completions
ELICE_API_URL=
ELICE_CHAT_MODEL=openai/gpt-5-mini
# The variables below are only used with PRISM_CHAT_PROVIDER=openai.
OPENAI_API_KEY=
# Set a structured-output capable model available in your API project.
OPENAI_CHAT_MODEL=
PRISM_CHAT_ENABLED=0
PRISM_DATA_SOURCE=fixture
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183
