# Server-only AI provider settings. Copy to .env.chat.local.
PRISM_CHAT_PROVIDER=elice
ELICE_API_KEY=
ELICE_API_URL=
ELICE_CHAT_MODEL=openai/gpt-5-mini
PRISM_CHAT_ENABLED=0
PRISM_DATA_SOURCE=fixture
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183
# Optional direct OpenAI provider.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
