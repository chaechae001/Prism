erDiagram
    NEWS_ARTICLES ||--o{ OBSERVATIONS : discovered_in
    NEWS_ARTICLES ||--o{ BODY_VERSIONS : has_revisions
    ANALYSIS_RUNS ||--o{ RUN_INPUTS : freezes
    NEWS_ARTICLES ||--o{ RUN_INPUTS : included
    BODY_VERSIONS ||--o{ RUN_INPUTS : exact_body_version
    EVENTS ||--o{ MEMBERS : groups
    RUN_INPUTS ||--o{ MEMBERS : assigned
    EVENTS ||--o{ ANALYSES : has_modes_and_versions
    ANALYSIS_RUNS ||--o{ ANALYSES : provenance
    EVENTS ||--o| PUBLICATIONS : reviewed_projection
    ANALYSES ||--o| PUBLICATIONS : main_summary
    NEWS_ARTICLES {
      uuid id PK
      text canonical_url UK
      jsonb record
      uuid current_body_id FK
      text analysis_signature
    }
    OBSERVATIONS {
      bigint id PK
      uuid article_id FK
      text provider
      text query
      jsonb payload
    }
    BODY_VERSIONS {
      uuid id PK
      uuid article_id FK
      text text
      text content_hash
      jsonb rights
      jsonb provenance
    }
    ANALYSIS_RUNS {
      uuid id PK
      text input_hash
      jsonb excluded
    }
    RUN_INPUTS {
      uuid run_id PK,FK
      uuid article_id PK,FK
      uuid body_id FK
      jsonb article_snapshot
    }
    EVENTS {
      uuid id PK
      text event_key UK
      uuid current_run_id FK
      boolean same_event_verified
    }
    MEMBERS {
      uuid event_id PK,FK
      uuid run_id PK,FK
      uuid article_id PK,FK
    }
    ANALYSES {
      uuid id PK
      uuid event_id FK
      uuid run_id FK
      text mode
      text model_version
      text prompt_version
      text review_status
      jsonb payload
    }
    PUBLICATIONS {
      uuid event_id PK,FK
      uuid run_id FK
      uuid analysis_id FK
      date event_date
      jsonb story
    }
