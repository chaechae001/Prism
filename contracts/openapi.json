  "components": {
    "schemas": {
      "Article": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "publisher_id": {
            "type": "string",
            "title": "Publisher Id"
          },
          "publisher_name": {
            "type": "string",
            "title": "Publisher Name"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "framing": {
            "type": "string",
            "title": "Framing"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo",
            "default": true
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "Original article image URL, when available. Optional for existing clients and data sources."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "publisher_id",
          "publisher_name",
          "title",
          "url",
          "published_at",
          "framing"
        ],
        "title": "Article"
      },
      "CategoriesResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CategoryInfo"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CategoriesResponse"
      },
      "CategoryInfo": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "politics",
              "economy",
              "society",
              "technology"
            ],
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "count"
        ],
        "title": "CategoryInfo"
      },
      "Citation": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "article_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Article Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "article_ids"
        ],
        "title": "Citation"
      },
      "Coverage": {
        "properties": {
          "publisher_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Publisher Count"
          },
          "article_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Article Count"
          },
          "perspective_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Perspective Count"
          },
          "label_status": {
            "type": "string",
            "enum": [
              "demo",
              "reviewed",
              "unverified"
            ],
            "title": "Label Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "publisher_count",
          "article_count",
          "perspective_count",
          "label_status"
        ],
        "title": "Coverage"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Details"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FeedItem": {
        "properties": {
          "story": {
            "$ref": "#/components/schemas/Story"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "story",
          "reason"
        ],
        "title": "FeedItem"
      },
      "FeedMeta": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "balanced",
              "latest",
              "explore"
            ],
            "title": "Mode"
          },
          "diversity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Diversity"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "mock-v1"
          },
          "policy_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Policy Notes"
          },
          "returned_categories": {
            "items": {
              "type": "string",
              "enum": [
                "politics",
                "economy",
                "society",
                "technology"
              ]
            },
            "type": "array",
            "title": "Returned Categories"
          },
          "source_cap_relaxed": {
            "type": "boolean",
            "title": "Source Cap Relaxed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "generated_at",
          "dataset_version",
          "mode",
          "diversity",
          "policy_notes",
          "returned_categories",
          "source_cap_relaxed"
        ],
        "title": "FeedMeta"
      },
      "FeedResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "meta": {
            "$ref": "#/components/schemas/FeedMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "next_cursor",
          "meta"
        ],
        "title": "FeedResponse"
      },
      "FeedbackRequest": {
        "properties": {
          "story_id": {
            "type": "string",
            "title": "Story Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "useful",
              "more_perspectives",
              "report_error"
            ],
            "title": "Kind"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
