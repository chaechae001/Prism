{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human-reviewed and training-permitted PRISM examples",
  "type": "array",
  "minItems": 1,
  "maxItems": 10000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "event_group", "input", "answer", "human_reviewed", "approved_for_training"],
    "properties": {
      "id": {"type": "string", "minLength": 1, "maxLength": 200},
      "event_group": {"type": "string", "minLength": 1, "maxLength": 200},
      "input": {"type": "string", "minLength": 1, "maxLength": 100000},
      "answer": {"type": "string", "minLength": 1, "maxLength": 100000},
      "human_reviewed": {"const": true},
      "approved_for_training": {"const": true},
      "is_demo": {"type": "boolean"}
    }
  }
}
