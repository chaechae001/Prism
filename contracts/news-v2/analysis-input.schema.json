{
  "$defs": {
    "AnalysisArticle": {
      "additionalProperties": false,
      "properties": {
        "article": {
          "$ref": "#/$defs/NewsRecord"
        },
        "body_version_id": {
          "format": "uuid",
          "title": "Body Version Id",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_basis": {
          "enum": [
            "full_text",
            "excerpt"
          ],
          "title": "Text Basis",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/BodyRights"
        }
      },
      "required": [
        "article",
        "body_version_id",
        "content_hash",
        "text",
        "text_basis",
        "rights"
      ],
      "title": "AnalysisArticle",
      "type": "object"
    },
    "BodyRights": {
      "additionalProperties": false,
      "properties": {
        "store": {
          "default": false,
          "title": "Store",
          "type": "boolean"
        },
        "cluster": {
          "default": false,
          "title": "Cluster",
          "type": "boolean"
        },
        "summarize": {
          "default": false,
          "title": "Summarize",
          "type": "boolean"
        },
        "analyze": {
          "default": false,
          "title": "Analyze",
          "type": "boolean"
        },
        "publish_summary": {
          "default": false,
          "title": "Publish Summary",
          "type": "boolean"
        },
        "display_full_text": {
          "default": false,
          "title": "Display Full Text",
          "type": "boolean"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "evidence"
      ],
      "title": "BodyRights",
      "type": "object"
    },
    "NewsRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "enum": [
            "naver_search",
            "rss",
            "demo"
          ],
          "title": "Provider",
          "type": "string"
        },
        "provider_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Provider Url",
          "type": "string"
        },
        "original_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Original Url",
          "type": "string"
        },
        "canonical_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Canonical Url",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/Publisher"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "enum": [
            "politics",
            "economy",
            "society",
            "technology"
          ],
          "title": "Category",
          "type": "string"
        },
        "category_basis": {
          "default": "collection_query",
          "enum": [
            "collection_query",
            "reviewed"
          ],
          "title": "Category Basis",
          "type": "string"
        },
        "provider_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Published At"
        },
        "publisher_published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher Published At"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "provider",
        "provider_url",
        "original_url",
        "canonical_url",
        "title",
        "snippet",
        "publisher",
        "category",
        "provider_published_at",
        "collected_at"
      ],
      "title": "NewsRecord",
      "type": "object"
    },
    "Publisher": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "group_id": {
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "group_id",
        "domains"
      ],
      "title": "Publisher",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "input_hash": {
      "title": "Input Hash",
      "type": "string"
    },
    "articles": {
      "items": {
        "$ref": "#/$defs/AnalysisArticle"
      },
      "title": "Articles",
      "type": "array"
    },
    "excluded": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Excluded",
      "type": "object"
    },
    "selection": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "title": "Selection",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "input_hash",
    "articles",
    "excluded"
  ],
  "title": "AnalysisBatch",
  "type": "object"
}