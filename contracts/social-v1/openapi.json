            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Perspective": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "article_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Article Ids"
          }
