          "id": {
            "type": "string",
            "title": "Id"
          },
          "publisher_id": {
            "type": "string",
            "title": "Publisher Id"
          },
          "publisher_name": {
            "type": "string",
            "title": "Publisher Name"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "framing": {
            "type": "string",
            "title": "Framing"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "publisher_id",
          "publisher_name",
          "title",
          "url",
          "published_at",
          "framing"
        ],
        "title": "Article"
      },
      "CategoriesResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CategoryInfo"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CategoriesResponse"
      },
      "CategoryInfo": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "politics",
              "economy",
              "society",
              "technology"
            ],
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "count"
        ],
        "title": "CategoryInfo"
      },
      "ChatReply": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Answer"
          },
          "article_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Article Ids"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "context_notice": {
            "type": "string",
            "title": "Context Notice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "article_ids",
          "model",
          "context_notice"
        ],
        "title": "ChatReply"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatStatus": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "notice": {
            "type": "string",
            "title": "Notice"
          },
          "context_notice": {
            "type": "string",
            "title": "Context Notice"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "notice",
          "context_notice"
        ],
        "title": "ChatStatus"
      },
      "Citation": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "article_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Article Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "article_ids"
        ],
        "title": "Citation"
      },
      "Coverage": {
        "properties": {
          "publisher_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Publisher Count"
          },
          "article_count": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Article Count"
          },
          "perspective_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Perspective Count"
          },
          "label_status": {
            "type": "string",
            "enum": [
              "demo",
              "reviewed",
              "unverified"
            ],
            "title": "Label Status"
          }
