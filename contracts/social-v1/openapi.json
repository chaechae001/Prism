            "default": "accepted"
          },
          "persisted": {
            "type": "boolean",
            "title": "Persisted",
            "default": false
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "request_id"
        ],
        "title": "FeedbackResponse"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
