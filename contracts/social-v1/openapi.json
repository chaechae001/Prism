          "meta": {
            "$ref": "#/components/schemas/FeedMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "next_cursor",
          "meta"
        ],
        "title": "FeedResponse"
      },
      "FeedbackRequest": {
        "properties": {
          "story_id": {
            "type": "string",
            "title": "Story Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "useful",
              "more_perspectives",
              "report_error"
            ],
            "title": "Kind"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
