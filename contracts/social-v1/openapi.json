        "additionalProperties": false,
        "type": "object",
        "required": [
          "publisher_count",
          "article_count",
          "perspective_count",
          "label_status"
        ],
        "title": "Coverage"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Details"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FeedItem": {
        "properties": {
          "story": {
            "$ref": "#/components/schemas/Story"
          },
          "reason": {
            "$ref": "#/components/schemas/Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "story",
          "reason"
        ],
        "title": "FeedItem"
      },
      "FeedMeta": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "balanced",
              "latest",
              "explore"
            ],
            "title": "Mode"
          },
          "diversity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Diversity"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "mock-v1"
          },
          "policy_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Policy Notes"
          },
          "returned_categories": {
            "items": {
              "type": "string",
              "enum": [
                "politics",
                "economy",
                "society",
                "technology"
              ]
            },
            "type": "array",
            "title": "Returned Categories"
          },
          "source_cap_relaxed": {
            "type": "boolean",
            "title": "Source Cap Relaxed"
          }
