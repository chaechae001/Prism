          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "title": "Reason"
      },
      "Story": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "category": {
            "type": "string",
            "enum": [
              "politics",
              "economy",
              "society",
              "technology"
            ],
            "title": "Category"
          },
          "dek": {
            "type": "string",
            "title": "Dek"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords"
          },
          "visual": {
            "type": "string",
            "enum": [
              "city",
              "chip",
              "energy",
              "school",
              "market",
              "assembly",
              "work",
              "research"
