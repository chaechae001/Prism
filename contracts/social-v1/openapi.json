            "type": "array",
            "title": "Perspectives"
          },
          "articles": {
            "items": {
              "$ref": "#/components/schemas/Article"
            },
            "type": "array",
            "title": "Articles"
          },
          "public_interest": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Public Interest"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "dek",
          "updated_at",
          "keywords",
          "visual",
          "coverage",
          "summary",
          "perspectives",
          "articles",
          "public_interest"
        ],
        "title": "Story"
