            "type": "array",
            "title": "Bullets"
          },
          "unknowns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknowns"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "bullets",
          "unknowns"
        ],
        "title": "Summary"
      }
