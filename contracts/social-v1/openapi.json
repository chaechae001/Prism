            "title": "Request Id"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "story",
          "request_id"
        ],
        "title": "StoryResponse"
      },
